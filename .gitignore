# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# Models & scraped data belong in the hash-verified registry / release artifacts,
# never in the tree. Cover every wrapped-model weight format as belt-and-suspenders
# against an accidental `git add` of licensed weights (RiboNN .pth, SpliceAI .h5,
# Pangolin state dicts) — these are lazily imported from the user's own install.
*.pt
*.pkl
*.pth
*.h5
*.hdf5
*.ckpt
*.onnx
*.pb
*.safetensors
~/.bt4/
external/

# Rust build artifacts (the crate's Cargo.lock IS committed for reproducibility)
rust/**/target/
*.so

# OS / editor
.DS_Store
.idea/
.vscode/
.claude/worktrees/
